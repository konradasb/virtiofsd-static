# The virtiofsd release built, and its crate's SHA-256, from
# https://crates.io/api/v1/crates/virtiofsd/<version> (the "checksum" field).
VIRTIOFSD_VERSION=1.14.0
VIRTIOFSD_SHA256=7051accc9cf2816e25945c8216e6d4be2b4e75fc5e77559cd7eed5e400245cc1

# The image it is built in: Rust on Alpine, whose musl and static libcap-ng
# and libseccomp make a binary with no dependencies on the host's libraries.
# Pinned by the digest of its multi-architecture index.
RUST_IMAGE=docker.io/library/rust:1.99.0-alpine3.24@sha256:a96ea6d18d4062e38f16cfbadd8b4541d622f2527dd0a5eca1fb36d301da4e88
